# This is a sample .env file for the REST API
# Copy this file to .env and fill in the values

#FusionPBX settings
FUSIONPBX_URL="https://example.com"
FUSIONPBX_USER="admin"
FUSIONPBX_PASSWORD="password"

# Listen address and port for the REST API
RESTAPI_HOST="localhost" # Listening address for the REST API Defaults to 0.0.0.0
RESTAPI_PORT="8080"      # Listening port for the REST API Defaults to 8000
RESTAPI_ORIGINS='["https://webphone.example.com", "http://localhost:3000"]' # Allowed origins for CORS requests

# Fief auth server

FIEF_CLIENT_ID=str
FIEF_CLIENT_SECRET=str

RESTAPI_ORIGINS='["https://webphone.example.com", "https://another-origin.com"]' # Allowed origins for CORS requests